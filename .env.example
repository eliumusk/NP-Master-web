# ─── Supabase (frontend + worker share) ────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ey...

# Service role (Vercel server routes + worker only — NEVER ship to client)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=ey...

# ─── Anti-abuse (Vercel only) ──────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# ─── Worker (Voc GPU host) ─────────────────────────────────────────
WORKER_ID=voc-node7-gpu0
NPMASTER_REPO_ROOT=/data/muskliu/npmaster
NPMASTER_CACHE_DIR=/data/muskliu/npmaster/cache/web
PYTHON_BIN=/root/miniconda3/envs/bgc/bin/python
MODEL_UNET_CKPT=/data/muskliu/npmaster/experiments/evo2_per_token_unet/train_runs/full_weakneg_bce_w05_ddp4_gb64_seed0/best.pt
LR_TYPE_CKPT_DIR=/data/muskliu/npmaster/data/evo2_lr_multiscale/type_lr

# Decode defaults — overridden per-job via jobs.threshold / jobs.min_len_bp
DEFAULT_THRESHOLD=0.50
DEFAULT_MIN_LEN_BP=2000
UPSAMPLE_K=8
EXTRACT_WINDOW=8192
EXTRACT_STRIDE=2048

# Parallel extract: comma-separated ssh hosts that share /data via NFS.
# "localhost" runs on the worker's own host. "node8" must be defined in
# /root/.ssh/config (we set it up to NAT through 221.194.152.152:50010).
EXTRACT_HOSTS=localhost,node8
EXTRACT_GPUS_PER_HOST=8

# Shared-GPU politeness
GPU_MIN_FREE_GB=20
GPU_WAIT_TIMEOUT_SEC=1800
GPU_POLL_SEC=30

# Limits & cadence
MAX_FASTA_BYTES=52428800
POLL_INTERVAL_SEC=5
HEARTBEAT_SEC=10

FASTA_BUCKET=fasta-uploads
RESULTS_BUCKET=results
