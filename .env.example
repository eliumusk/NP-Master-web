# BGCMaster environment.
# Use one Supabase project for all four values below. Do not mix placeholder
# NEXT_PUBLIC_* values with a real service-role project.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Supabase now labels this as publishable key. NEXT_PUBLIC_SUPABASE_ANON_KEY is also accepted for older projects.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_SUPABASE_ANON_KEY=ey...
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=ey...

WORKER_ID=bgcmaster-worker-1
NPMASTER_REPO_ROOT=/data/muskliu/npmaster
NPMASTER_CACHE_DIR=/data/muskliu/npmaster/cache/bgcmaster
PYTHON_BIN=/data/conda/miniconda/envs/evo2_bgc/bin/python

MODEL_UNET_CKPT=/data/muskliu/npmaster/experiments/evo2_per_token_unet/train_runs/full_weakneg_bce_w05_ddp4_gb64_seed0/best.pt
TYPE_HEAD_JOBLIB=/data/muskliu/npmaster/experiments/evo2_mibig_type/run_full/type_head.joblib

PRODIGAL_BIN=/root/miniconda3/envs/bgc/bin/prodigal
DIAMOND_BIN=/root/miniconda3/envs/bgc/bin/diamond
MIBIG_DMND_PATH=/data/syh/NP-Master-web/data/mibig/mibig.dmnd
MIBIG_META_PATH=/data/syh/NP-Master-web/data/mibig/mibig_meta.json
HMMER_BIN=/root/miniconda3/envs/bgc/bin/hmmscan
PFAM_DB_PATH=/data/syh/NP-Master-web/data/pfam/Pfam-A.hmm
HMMER_THREADS=48

DEFAULT_THRESHOLD=0.95
DEFAULT_EXTEND_THRESHOLD=0.80
DEFAULT_MIN_SUPPORT_WINDOWS=3
DEFAULT_MIN_LEN_BP=2000
DEFAULT_SAFE_TIER_MIN=Tier2
DEFAULT_EXTEND_FLANK_BP=5000
UPSAMPLE_K=8
EXTRACT_WINDOW=8192
EXTRACT_STRIDE=2048

EXTRACT_HOSTS=localhost,node8
EXTRACT_GPUS_PER_HOST=8
USE_PRECOMPUTED_9G_PROBS=true
USE_FEATURE_CACHE=true
GPU_MIN_FREE_GB=20
GPU_WAIT_TIMEOUT_SEC=1800
GPU_POLL_SEC=30

MAX_FASTA_BYTES=52428800
POLL_INTERVAL_SEC=5
HEARTBEAT_SEC=10
FASTA_BUCKET=fasta-uploads
RESULTS_BUCKET=results
