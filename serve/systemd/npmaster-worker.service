[Unit]
Description=NP-Master web-service GPU worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/data/syh/NP-Master-web
EnvironmentFile=/data/syh/NP-Master-web/serve/.env
ExecStart=/data/syh/NP-Master-web/.venv-serve/bin/python -m serve.worker
Restart=on-failure
RestartSec=15
Nice=10
IOSchedulingClass=idle
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
